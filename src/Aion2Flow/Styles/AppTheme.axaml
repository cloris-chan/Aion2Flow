<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:simple="using:Avalonia.Themes.Simple"
        x:Class="Cloris.Aion2Flow.Styles.AppTheme">
