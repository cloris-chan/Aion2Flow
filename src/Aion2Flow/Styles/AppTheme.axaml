    <StyleInclude Source="avares://Aion2Flow/Styles/CommonTheme.axaml" />
    <StyleInclude Source="avares://Aion2Flow/Styles/OverlayTheme.axaml" />
    <StyleInclude Source="avares://Aion2Flow/Styles/PlaybackTheme.axaml" />
    <StyleInclude Source="avares://Aion2Flow/Styles/SettingsTheme.axaml" />
</Styles>
