<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls">
    <StyleInclude Source="avares://Aion2Flow/Styles/CommonTheme.axaml" />

    <Styles.Resources>
        <SolidColorBrush x:Key="PlaybackBrush.Window">#14181D</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TopBar">#1B222A</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.Panel">#1E252D</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.PanelStrong">#27313B</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.Control">#252E38</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.ControlHover">#2D3A45</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.Border">#35424E</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.BorderStrong">#526676</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.Text">#EEF4F8</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TextMuted">#AAB8C4</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TextSubtle">#82909D</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.Accent">#22D3EE</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.AccentFill">#2E96A8</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.Green">#89D66B</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineTrack">#10161C</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.Row">#172028</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.RowHover">#202C36</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.Expanded">#202831</SolidColorBrush>
    </Styles.Resources>

    <Style Selector="Window.PlaybackWindow">
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.Window}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Text}" />
    </Style>

    <Style Selector="Border.PlaybackTopBar">
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.TopBar}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaybackBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,9" />
    </Style>

    <Style Selector="Border.PlaybackPanel">
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaybackBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="TextBlock.PlaybackPanelTitle">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackSceneTitle">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.PlaybackHeaderSubtle">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackHeaderStatus">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Accent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.PlaybackIconButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.Control}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaybackBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.PlaybackIconButton.PlaybackPrimaryButton">
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.AccentFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaybackBrush.Accent}" />
    </Style>

    <Style Selector="Button.PlaybackIconButton.PlaybackExpandButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.PanelStrong}" />
    </Style>

    <Style Selector="Button.PlaybackTextButton">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.Control}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaybackBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.PlaybackIconButton:pointerover, Button.PlaybackTextButton:pointerover">
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.ControlHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaybackBrush.BorderStrong}" />
    </Style>

    <Style Selector="Button.PlaybackIconButton.PlaybackPrimaryButton:pointerover">
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.AccentFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaybackBrush.Text}" />
    </Style>

    <Style Selector="Path.PlaybackGlyph">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <Style Selector="Border.PlaybackToolbarDivider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.Border}" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.PlaybackSpeedReadout">
        <Setter Property="MinWidth" Value="46" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.PlaybackTimelineLegend">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackMetricLabel">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackMetricValue">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="Grid.PlaybackAlignedTimelineGrid">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.PlaybackTrackAccent">
        <Setter Property="Width" Value="5" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|PlaybackTimelineStripView.PlaybackTimelineStrip">
        <Setter Property="Height" Value="26" />
        <Setter Property="TrackBrush" Value="{StaticResource PlaybackBrush.TimelineTrack}" />
        <Setter Property="PlayheadBrush" Value="{StaticResource PlaybackBrush.Accent}" />
        <Setter Property="PlayheadThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|PlaybackTimelineStripView.PlaybackGlobalTimelineStrip">
        <Setter Property="Height" Value="28" />
        <Setter Property="PlayheadThickness" Value="3" />
    </Style>

    <Style Selector="controls|PlaybackTimelineStripView.PlaybackCombatantTimelineStrip">
        <Setter Property="Height" Value="32" />
    </Style>

    <Style Selector="controls|PlaybackTimelineStripView.PlaybackScrollbarGutter">
        <Setter Property="Margin" Value="0,0,20,0" />
    </Style>

    <Style Selector="Grid.PlaybackTableHeader.PlaybackScrollbarGutter">
        <Setter Property="Margin" Value="0,0,20,2" />
    </Style>

    <Style Selector="controls|PlaybackTimelineView.PlaybackTimelineRail">
        <Setter Property="Height" Value="22" />
        <Setter Property="TrackBrush" Value="{StaticResource PlaybackBrush.TimelineTrack}" />
        <Setter Property="PlayheadBrush" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="PlayheadThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|PlaybackTimelineView.PlaybackAuraTimelineLane">
        <Setter Property="Height" Value="24" />
    </Style>

    <Style Selector="controls|PlaybackTimelineView.PlaybackSkillTimelineLane">
        <Setter Property="Height" Value="24" />
    </Style>

    <Style Selector="controls|PlaybackTimelineView.PlaybackEventTimelineLane">
        <Setter Property="Height" Value="20" />
    </Style>

    <Style Selector="controls|PlaybackTimelineStripView.PlaybackTimelineBackgroundStrip">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="TrackBrush" Value="Transparent" />
        <Setter Property="PlayheadBrush" Value="#B022D3EE" />
        <Setter Property="PlayheadThickness" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="controls|PlaybackTimelineView.PlaybackTimelineBackgroundRail">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Opacity" Value="0.62" />
        <Setter Property="TrackBrush" Value="Transparent" />
        <Setter Property="PlayheadBrush" Value="#A0EEF4F8" />
        <Setter Property="PlayheadThickness" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="controls|SkillDisplay.PlaybackAuraSkill">
        <Setter Property="IconSpacing" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|SkillDisplay.PlaybackAuraSkill TextBlock#PART_Text">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ScrollViewer.PlaybackPanelScroller">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="Grid.PlaybackTableHeader">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style Selector="TextBlock.PlaybackHeaderCell, TextBlock.PlaybackHeaderCellRight">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackHeaderCellRight">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style Selector="Grid.PlaybackCombatantItem">
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Grid.PlaybackCombatantRow, Grid.PlaybackEventRow">
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.Row}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Grid.PlaybackCombatantRow:pointerover, Grid.PlaybackEventRow:pointerover">
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.RowHover}" />
    </Style>

    <Style Selector="Grid.PlaybackCombatantRow">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Grid.PlaybackCombatantItem.PlaybackSelected Grid.PlaybackCombatantRow">
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.ControlHover}" />
    </Style>

    <Style Selector="Border.PlaybackExpandedCombatant">
        <Setter Property="Background" Value="#A019222A" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaybackBrush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,8,0,6" />
    </Style>

    <Style Selector="Border.PlaybackDetailSectionHeader">
        <Setter Property="Background" Value="#7A111921" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaybackBrush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style Selector="Border.PlaybackDetailTimelineRow">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="{StaticResource PlaybackBrush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Grid.PlaybackDetailTimelineGrid">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="StackPanel.PlaybackInlineMetric">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.PlaybackDetailAmount">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackDetailSubtle">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackDetailSubtleValue">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Grid.PlaybackEventRow">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style Selector="controls|CombatantDisplay.PlaybackCombatantName">
        <Setter Property="IconSize" Value="20" />
        <Setter Property="IconSpacing" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|CombatantDisplay.PlaybackCombatantName TextBlock#PART_Text">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.PlaybackRowValue">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackNumericCell">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackRowSubtle">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackTrackName">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackTrackCount">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.PlaybackEventTime">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Accent}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackEventTrack">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackEventText">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackEventAmount">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Green}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="controls|SegmentedProgressBar.PlaybackHpBar">
        <Setter Property="Height" Value="16" />
        <Setter Property="Background" Value="{StaticResource PlaybackBrush.TimelineTrack}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Grid.PlaybackHpCell">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="TextBlock.PlaybackHpText">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Text}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</Styles>
