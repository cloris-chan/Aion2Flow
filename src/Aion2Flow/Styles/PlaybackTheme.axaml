<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls">
    <StyleInclude Source="avares://Aion2Flow/Styles/CommonTheme.axaml" />

    <Styles.Resources>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineTrack">#060B0F</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineCombat">#18D7F4</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineMechanic">#FFD166</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineResource">#55D6BE</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineEntityVital">#8CE271</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineAura">#C98EFF</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineState">#FFD166</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineScene">#FF8A65</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineAction">#65A7FF</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineDiagnostic">#9AA8B4</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.TimelineOther">#D4DCE5</SolidColorBrush>
        <SolidColorBrush x:Key="PlaybackBrush.Positive">#89D66B</SolidColorBrush>
    </Styles.Resources>

    <Style Selector="Window.PlaybackWindow">
        <Setter Property="Background" Value="{StaticResource AppBrush.Canvas}" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
    </Style>

    <Style Selector="Border.PlaybackCommandBar">
        <Setter Property="Background" Value="{StaticResource AppBrush.Band}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.PlaybackOverviewBand">
        <Setter Property="Background" Value="{StaticResource AppBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.PlaybackRosterPane">
        <Setter Property="Background" Value="{StaticResource AppBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.PlaybackWorkspacePane">
        <Setter Property="Background" Value="{StaticResource AppBrush.Canvas}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.PlaybackSelectionSummary">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="TextBlock.PlaybackPanelTitle">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackSceneTitle">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackHeaderSubtle">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackHeaderStatus">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Accent}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.PlaybackIconButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.PlaybackIconButton:pointerover">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
    </Style>

    <Style Selector="Button.PlaybackIconButton:pressed">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceSelected}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.SeparatorStrong}" />
    </Style>

    <Style Selector="Button.PlaybackIconButton:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.PlaybackIconButton.PlaybackPrimaryButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Accent}" />
    </Style>

    <Style Selector="Button.PlaybackIconButton.PlaybackPrimaryButton:pointerover">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceSelected}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.AccentStrong}" />
    </Style>

    <Style Selector="Path.PlaybackGlyph">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{StaticResource AppBrush.Text}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <Style Selector="Button.PlaybackPrimaryButton Path.PlaybackGlyph">
        <Setter Property="Stroke" Value="{StaticResource AppBrush.AccentStrong}" />
    </Style>

    <Style Selector="Border.PlaybackToolbarDivider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="{StaticResource AppBrush.Separator}" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.PlaybackSpeedButton">
        <Setter Property="MinWidth" Value="42" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="-1,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.PlaybackSpeedButton:pointerover">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.SeparatorStrong}" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
    </Style>

    <Style Selector="Button.PlaybackSpeedButton.PlaybackSelected, Button.PlaybackSpeedButton.selected, ToggleButton.PlaybackSpeedButton:checked">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceSelected}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.AccentStrong}" />
    </Style>

    <Style Selector="Border.PlaybackWorkspaceTabStrip">
        <Setter Property="Background" Value="{StaticResource AppBrush.Band}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style Selector="Button.PlaybackWorkspaceTab">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.PlaybackWorkspaceTab:pointerover">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceHover}" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
    </Style>

    <Style Selector="Button.PlaybackWorkspaceTab.PlaybackSelected">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceSelected}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.AccentStrong}" />
    </Style>

    <Style Selector="TextBlock.PlaybackMetricLabel">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackMetricValue">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="Border.PlaybackTrackAccent">
        <Setter Property="Width" Value="4" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|PlaybackTimelineStripView.PlaybackTimelineStrip">
        <Setter Property="Height" Value="26" />
        <Setter Property="TrackBrush" Value="{StaticResource PlaybackBrush.TimelineTrack}" />
        <Setter Property="PlayheadBrush" Value="{StaticResource AppBrush.AccentStrong}" />
        <Setter Property="PlayheadThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|PlaybackTimelineStripView.PlaybackGlobalTimelineStrip">
        <Setter Property="Height" Value="28" />
        <Setter Property="PlayheadThickness" Value="3" />
    </Style>

    <Style Selector="controls|PlaybackTimelineRulerView.PlaybackTimelineRuler">
        <Setter Property="Height" Value="30" />
        <Setter Property="TrackBrush" Value="Transparent" />
        <Setter Property="TickBrush" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="MinorTickBrush" Value="{StaticResource AppBrush.SeparatorStrong}" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextSubtle}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="PlayheadBrush" Value="{StaticResource AppBrush.AccentStrong}" />
        <Setter Property="PlayheadThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="controls|PlaybackTimelineView.PlaybackTimelineRail">
        <Setter Property="Height" Value="22" />
        <Setter Property="TrackBrush" Value="{StaticResource PlaybackBrush.TimelineTrack}" />
        <Setter Property="PlayheadBrush" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="PlayheadThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|PlaybackTimelineView.PlaybackAuraTimelineLane">
        <Setter Property="Height" Value="24" />
    </Style>

    <Style Selector="controls|PlaybackTimelineStripView.PlaybackTimelineBackgroundStrip">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="TrackBrush" Value="Transparent" />
        <Setter Property="PlayheadBrush" Value="{StaticResource AppBrush.Accent}" />
        <Setter Property="PlayheadThickness" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="controls|PlaybackTimelineView.PlaybackTimelineBackgroundRail">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Opacity" Value="0.62" />
        <Setter Property="TrackBrush" Value="Transparent" />
        <Setter Property="PlayheadBrush" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="PlayheadThickness" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="ListBox.PlaybackWorkspaceList">
        <Setter Property="Background" Value="{StaticResource AppBrush.Canvas}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.PlaybackWorkspaceList ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ListBox.PlaybackWorkspaceList ListBoxItem:pointerover, ListBox.PlaybackWorkspaceList ListBoxItem:selected">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="controls|SkillDisplay.PlaybackAuraSkill">
        <Setter Property="IconSpacing" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|SkillDisplay.PlaybackAuraSkill TextBlock#PART_Text">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Grid.PlaybackTableHeader">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{StaticResource AppBrush.Band}" />
    </Style>

    <Style Selector="TextBlock.PlaybackHeaderCell, TextBlock.PlaybackHeaderCellRight">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackHeaderCellRight">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style Selector="Border.PlaybackEventRow">
        <Setter Property="Background" Value="{StaticResource AppBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style Selector="Border.PlaybackEventRow:pointerover">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceHover}" />
    </Style>

    <Style Selector="Border.PlaybackCombatantRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.PlaybackCombatantRow:pointerover">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceHover}" />
    </Style>

    <Style Selector="Border.PlaybackCombatantRow.selected">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceSelected}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Accent}" />
    </Style>

    <Style Selector="Border.PlaybackDetailTimelineRow">
        <Setter Property="Background" Value="{StaticResource AppBrush.Surface}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.PlaybackDetailTimelineRow:pointerover">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceHover}" />
    </Style>

    <Style Selector="Grid.PlaybackDetailTimelineGrid">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="StackPanel.PlaybackInlineMetric">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.PlaybackDetailSubtle">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackDetailSubtleValue">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|CombatantDisplay.PlaybackCombatantName">
        <Setter Property="IconSize" Value="20" />
        <Setter Property="IconSpacing" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|CombatantDisplay.PlaybackCombatantName TextBlock#PART_Text">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.PlaybackRowValue">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackNumericCell">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackRowSubtle">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackTrackName">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackEventTime">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Accent}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackEventTrack">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackEventText">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackEventAmount">
        <Setter Property="Foreground" Value="{StaticResource PlaybackBrush.Positive}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.PlaybackEmptyState">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ScrollViewer.PlaybackDetailScroller">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{StaticResource AppBrush.Canvas}" />
    </Style>

    <Style Selector="GridSplitter.PlaybackHorizontalSplitter">
        <Setter Property="Background" Value="{StaticResource AppBrush.Separator}" />
    </Style>

    <Style Selector="Border.PlaybackEventScopeBar">
        <Setter Property="Background" Value="{StaticResource AppBrush.Band}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style Selector="Button.PlaybackBreadcrumbButton">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.PlaybackBreadcrumbButton:pointerover">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceHover}" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
    </Style>

    <Style Selector="Button.PlaybackBreadcrumbButton.PlaybackSelected">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.AccentStrong}" />
    </Style>

    <Style Selector="Path.PlaybackBreadcrumbSeparator">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{StaticResource AppBrush.TextSubtle}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PlaybackBreadcrumbCurrent">
        <Setter Property="Foreground" Value="{StaticResource AppBrush.AccentStrong}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="280" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <Style Selector="ListBox.PlaybackAuraList ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceSelected}" />
    </Style>

</Styles>
