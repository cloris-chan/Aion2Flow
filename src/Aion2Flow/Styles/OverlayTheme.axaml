<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
        xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base">
    <StyleInclude Source="avares://Aion2Flow/Styles/CommonTheme.axaml" />

    <Styles.Resources>
        <SolidColorBrush x:Key="OverlayBrush.Surface">#26131B25</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.SurfaceSoft">#1C0E141B</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.Highlight">#2F6FA3C7</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.HighlightStrong">#5E8CBDE4</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.Border">#476B859A</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.BorderStrong">#77A6C4DD</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.Text">#F1F6FB</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.TextMuted">#B0C1D0</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.TextSubtle">#8595A2</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.EmptyStateText">#D7E4EF</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.RowMetricText">#C4D1DC</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.MainAccent">#E3C78C</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.MainHudBackdrop">#A80A0D0F</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.MainHudContentBackdrop">#780A0D0F</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.MainHudPanelHover">#24192225</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.MainHudPanelSelected">#321A2528</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.MainHudGold">#E6D39A</SolidColorBrush>
        <LinearGradientBrush x:Key="OverlayBrush.MainHudFooterSeparator"
                             StartPoint="0%,50%"
                             EndPoint="100%,50%">
            <GradientStop Color="#00A6C4DD" Offset="0" />
            <GradientStop Color="#58A6C4DD" Offset="0.16" />
            <GradientStop Color="#58A6C4DD" Offset="0.84" />
            <GradientStop Color="#00A6C4DD" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailBackdrop">#9E060A0D</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailSurface">#52060A0D</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailSurfaceStrong">#6A070B0E</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailCard">#72070B0F</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailHudPanel">#5405080B</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailHudPanelSoft">#3205080B</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailHudPanelHover">#4A0A151D</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailHudLine">#4A7D9AAE</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailHudLineSoft">#38FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailSeparator">#30FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.DetailDamageShareFill">#C20B5F59</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush.SettingsBackdrop">#F0060A0D</SolidColorBrush>
    </Styles.Resources>

    <Style Selector="Window.OverlayWindow">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Grid.MainHudShell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.MainHudHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style Selector="Border.MainHudHeaderBackdrop">
        <Setter Property="Background" Value="{StaticResource OverlayBrush.MainHudBackdrop}" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.MainHudContentBackdrop">
        <Setter Property="Background" Value="{StaticResource OverlayBrush.MainHudContentBackdrop}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector=".MainHudForeground"
           x:SetterTargetType="Control">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Grid.MainHudShell.click-through Border.MainHudHeaderBackdrop,
                     Grid.MainHudShell.click-through Border.MainHudContentBackdrop">
        <Setter Property="Opacity" Value="0.18" />
    </Style>

    <Style Selector="Grid.MainHudShell.click-through.cursor-over Border.MainHudHeaderBackdrop,
                     Grid.MainHudShell.click-through.cursor-over Border.MainHudContentBackdrop">
        <Setter Property="Opacity" Value="0" />
    </Style>

    <Style Selector="Grid.MainHudShell.click-through.cursor-over .MainHudForeground"
           x:SetterTargetType="Control">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="Border.MainHudFooter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style Selector="Border.MainHudFooterSeparator">
        <Setter Property="Background" Value="{StaticResource OverlayBrush.MainHudFooterSeparator}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Effect">
            <media:DropShadowDirectionEffect BlurRadius="3"
                                             ShadowDepth="0"
                                             Opacity="0.8"
                                             Color="#B0000000" />
        </Setter>
    </Style>

    <Style Selector="controls|NumericBlock">
        <Setter Property="Effect">
            <media:DropShadowDirectionEffect BlurRadius="3"
                                             ShadowDepth="0"
                                             Opacity="0.8"
                                             Color="#B0000000" />
        </Setter>
    </Style>

    <Style Selector="TextBlock.OverlayPrimaryText">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
    </Style>

    <Style Selector="TextBlock.OverlayMutedText">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextMuted}" />
    </Style>

    <Style Selector="TextBlock.OverlayEmptyStateText">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.EmptyStateText}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.OverlayCaptionText">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextSubtle}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="controls|NumericBlock.OverlayHeaderMetric">
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Primary}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.OverlayHeaderScene">
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Primary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="ItemsControl.BossFocusList">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Border.BossFocusPanel">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="controls|NpcDisplay.BossFocusName TextBlock#PART_Text">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.MainHudGold}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Primary}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Border.BossFocusCountBadge">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="TextBlock.BossFocusCountText">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|NumericBlock.BossFocusHp">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Primary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.BossFocusHpMuted">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.88" />
    </Style>

    <Style Selector="controls|NumericBlock.BossFocusHpMuted">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.BossFocusHpSlash">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style Selector="controls|BossFocusProgressBar.BossFocusHpBar">
        <Setter Property="Background" Value="#FF000000" />
        <Setter Property="OuterShadowBrush" Value="#B8000000" />
        <Setter Property="FrameBrush" Value="#D0957A47" />
        <Setter Property="InnerShadowBrush" Value="#E0000000" />
        <Setter Property="ChamferWidth" Value="8" />
        <Setter Property="FrameThickness" Value="2" />
        <Setter Property="FlowSpeed" Value="0.9" />
        <Setter Property="FlowStrength" Value="1" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="controls|NumericBlock.BossFocusPercent">
        <Setter Property="Foreground" Value="#F8FFFFFF" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style Selector="Border.TitleBarDragRegion">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,0,5,0" />
        <Setter Property="MinHeight" Value="29" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="StackPanel.TitleBarActions">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.WindowBtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Path.Glyph">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{StaticResource OverlayBrush.Text}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Stroke" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Path.GlyphSm">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style Selector="Path.GlyphMd">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <Style Selector="Path.GlyphLg">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="Button.WindowBtn Path.Glyph">
        <Setter Property="Stroke" Value="{StaticResource OverlayBrush.TextMuted}" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Stroke" Duration="0:0:0.18" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.WindowBtn:pointerover">
        <Setter Property="Background" Value="{StaticResource OverlayBrush.MainHudPanelHover}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.WindowBtn:pointerover Path.Glyph">
        <Setter Property="Stroke" Value="{StaticResource OverlayBrush.Text}" />
    </Style>

    <Style Selector="Button.MinBtn Path.Glyph">
        <Setter Property="RenderTransform" Value="translateY(2px)" />
    </Style>

    <Style Selector="Button.MinBtn:pointerover Path.Glyph">
        <Setter Property="RenderTransform" Value="translateY(4px) scale(1.08)" />
    </Style>

    <Style Selector="Button.RefreshBtn:pointerover Path.Glyph">
        <Setter Property="RenderTransform" Value="rotate(120deg)" />
    </Style>

    <Style Selector="Button.CloseBtn:pointerover">
        <Setter Property="Background" Value="#66F07C82" />
    </Style>

    <Style Selector="Button.CloseBtn:pointerover Path.Glyph">
        <Setter Property="Stroke" Value="{StaticResource OverlayBrush.Text}" />
        <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>

    <Style Selector="Button.CloseBtn:pressed Path.Glyph">
        <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>

    <Style Selector="Button.BottomBarButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.BottomBarButton:disabled Path.Glyph">
        <Setter Property="Stroke" Value="{StaticResource OverlayBrush.TextSubtle}" />
    </Style>

    <Style Selector="Button.BottomBarButton:pointerover">
        <Setter Property="Background" Value="#16FFFFFF" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.BottomBarButton:pressed">
        <Setter Property="Background" Value="#24FFFFFF" />
    </Style>

    <Style Selector="Button.BottomBarButton:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.OverlayPinButton Path.Glyph">
        <Setter Property="Stroke" Value="{StaticResource OverlayBrush.TextSubtle}" />
    </Style>

    <Style Selector="Button.OverlayPinButton.click-through Path.Glyph">
        <Setter Property="Stroke" Value="{StaticResource OverlayBrush.Text}" />
    </Style>

    <Style Selector="Button.OverlayPinButton.hidden Path.Glyph">
        <Setter Property="Stroke" Value="{StaticResource OverlayBrush.MainHudGold}" />
    </Style>

    <Style Selector="Button.FlyoutInlineButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.FlyoutInlineButton Path.Glyph">
        <Setter Property="Stroke" Value="{StaticResource OverlayBrush.TextMuted}" />
    </Style>

    <Style Selector="Button.FlyoutInlineButton:pointerover">
        <Setter Property="Background" Value="{StaticResource OverlayBrush.DetailHudPanelHover}" />
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
    </Style>

    <Style Selector="Button.FlyoutInlineButton:pointerover Path.Glyph">
        <Setter Property="Stroke" Value="{StaticResource OverlayBrush.Text}" />
    </Style>

    <Style Selector="MenuItem.FlyoutMenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="3,1" />
    </Style>

    <Style Selector="MenuItem.FlyoutMenuItem /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style Selector="MenuItem.FlyoutMenuItem /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Margin" Value="{Binding $parent[MenuItem].Padding}" />
    </Style>

    <Style Selector="MenuItem.FlyoutMenuItem /template/ TextBlock#PART_InputGestureText">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="MenuItem.FlyoutMenuItem:pointerover">
        <Setter Property="Background" Value="#28FFFFFF" />
    </Style>

    <Style Selector="MenuItem.FlyoutMenuItem:pressed">
        <Setter Property="Background" Value="#30202020" />
    </Style>

    <Style Selector="MenuItem.FlyoutMenuItemPlaceholder:disabled">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextSubtle}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="MenuItem.FlyoutMenuItem /template/ Popup#PART_Popup > Border">
        <Setter Property="Background" Value="#E40C1116" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="MenuItem.FlyoutMenuItem /template/ Path#PART_ChevronPath">
        <Setter Property="Fill" Value="{StaticResource OverlayBrush.TextMuted}" />
    </Style>

    <Style Selector="MenuItem.FlyoutMenuItem:open /template/ Path#PART_ChevronPath">
        <Setter Property="Fill" Value="{StaticResource OverlayBrush.Text}" />
    </Style>

    <Style Selector="Border.SettingsCard">
        <Setter Property="Background" Value="{StaticResource OverlayBrush.SettingsBackdrop}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="244" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Menu.SettingsMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="NaN" />
    </Style>

    <Style Selector="MenuItem.FlyoutPanelRow">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.DetailSeparator}" />
        <Setter Property="BorderThickness" Value="2,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style Selector="MenuItem.FlyoutPanelRow /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="{Binding $parent[MenuItem].Padding}" />
    </Style>

    <Style Selector="MenuItem.SettingsRowItem /template/ Popup#PART_Popup">
        <Setter Property="Placement" Value="RightEdgeAlignedTop" />
        <Setter Property="HorizontalOffset" Value="4" />
    </Style>

    <Style Selector="MenuItem.SettingsRowItem /template/ Popup#PART_Popup > Border">
        <Setter Property="Background" Value="{StaticResource OverlayBrush.SettingsBackdrop}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="MenuItem.SettingsRowItem /template/ Popup#PART_Popup > Border > ScrollViewer > ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="MenuItem.SettingsOptionItem">
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.DetailSeparator}" />
        <Setter Property="BorderThickness" Value="2,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="9,6" />
    </Style>

    <Style Selector="MenuItem.SettingsOptionItem:pointerover">
        <Setter Property="Background" Value="{StaticResource OverlayBrush.DetailHudPanelHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.DetailHudLineSoft}" />
    </Style>

    <Style Selector="TextBlock.SettingsRowLabel">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.SettingsRowValue">
        <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0,4,0" />
    </Style>

    <Style Selector="Border.SettingsScaleRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.DetailSeparator}" />
        <Setter Property="BorderThickness" Value="2,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Border.SettingsScaleRow:pointerover">
