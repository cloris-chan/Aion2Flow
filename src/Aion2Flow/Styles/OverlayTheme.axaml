    <Style Selector="Border.DetailTableHeaderBand">
        <Setter Property="Background" Value="{StaticResource OverlayBrush.DetailHudPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.DetailHudLineSoft}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style Selector="Border.DetailTableRow">
        <Setter Property="Background" Value="Transparent" />
