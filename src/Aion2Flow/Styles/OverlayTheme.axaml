    <Style Selector="Border.DetailActionPanel">
        <Setter Property="Background" Value="{StaticResource OverlayBrush.DetailHudPanelSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.DetailHudLineSoft}" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="Padding" Value="8,8,8,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.DetailActionTitle">
