<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
        xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base">
    <Styles.Resources>
        <media:FontFamily x:Key="AppFontFamily">Segoe UI</media:FontFamily>
        <x:Double x:Key="AppFontSize.Caption">11</x:Double>
        <x:Double x:Key="AppFontSize.Body">12</x:Double>
        <x:Double x:Key="AppFontSize.Primary">13</x:Double>
        <x:Double x:Key="AppFontSize.Emphasis">15</x:Double>
        <x:Double x:Key="AppFontSize.Title">18</x:Double>

        <SolidColorBrush x:Key="AppBrush.Canvas">#080C10</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.Band">#0C1217</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.Surface">#111920</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.SurfaceRaised">#151F27</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.SurfaceHover">#1A2730</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.SurfaceSelected">#222B2E</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.Separator">#2B3944</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.SeparatorStrong">#526676</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.Text">#F1F6FB</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.TextMuted">#B0C1D0</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.TextSubtle">#8595A2</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.Accent">#E3C78C</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.AccentStrong">#F0DCA8</SolidColorBrush>

        <SolidColorBrush x:Key="CommonBrush.ScrollbarTrack">#3403080C</SolidColorBrush>
        <SolidColorBrush x:Key="CommonBrush.ScrollbarThumb">#688AA4B6</SolidColorBrush>
        <SolidColorBrush x:Key="CommonBrush.ScrollbarThumbHover">#86B5C9D6</SolidColorBrush>

        <ControlTheme x:Key="CommonScrollbarPageButtonTheme"
                      TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="CommonScrollbarThumbTheme"
                      TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource CommonBrush.ScrollbarThumb}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="999" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{StaticResource CommonBrush.ScrollbarThumbHover}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{StaticResource CommonBrush.ScrollbarThumbHover}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="CommonScrollbarTheme"
                      TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource CommonBrush.ScrollbarTrack}" />
            <Setter Property="Foreground" Value="{StaticResource CommonBrush.ScrollbarThumb}" />

            <Style Selector="^:horizontal">
                <Setter Property="Height" Value="12" />
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid Height="{TemplateBinding Height}">
                            <Border Height="6"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="999"
                                    VerticalAlignment="Center" />
                            <Track Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseButton>
                                    <RepeatButton Theme="{StaticResource CommonScrollbarPageButtonTheme}"
                                                  Focusable="False" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Theme="{StaticResource CommonScrollbarPageButtonTheme}"
                                                  Focusable="False" />
                                </Track.IncreaseButton>
                                <Thumb Name="AppScrollbarThumb"
                                       Theme="{StaticResource CommonScrollbarThumbTheme}"
                                       MinWidth="48"
                                       Height="6"
                                       VerticalAlignment="Center" />
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Style>

            <Style Selector="^:vertical">
                <Setter Property="Width" Value="12" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid Width="{TemplateBinding Width}">
                            <Border Width="6"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="999"
                                    HorizontalAlignment="Center" />
                            <Track Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseButton>
                                    <RepeatButton Theme="{StaticResource CommonScrollbarPageButtonTheme}"
                                                  Focusable="False" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Theme="{StaticResource CommonScrollbarPageButtonTheme}"
                                                  Focusable="False" />
                                </Track.IncreaseButton>
                                <Thumb Name="AppScrollbarThumb"
                                       Theme="{StaticResource CommonScrollbarThumbTheme}"
                                       Width="6"
                                       MinHeight="48"
                                       HorizontalAlignment="Center" />
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="TemplatedControl">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
    </Style>

    <Style Selector="controls|NumericBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
    </Style>

    <Style Selector="ScrollViewer.AppScrollViewer /template/ ScrollBar">
        <Setter Property="Theme" Value="{StaticResource CommonScrollbarTheme}" />
    </Style>

    <Style Selector="ListBox.AppScrollViewer /template/ ScrollViewer /template/ ScrollBar">
        <Setter Property="Theme" Value="{StaticResource CommonScrollbarTheme}" />
    </Style>

    <Style Selector="Popup">
        <Setter Property="InheritsTransform" Value="True" />
    </Style>
</Styles>
