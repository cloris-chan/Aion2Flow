<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
        xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base">
    <Styles.Resources>
        <media:FontFamily x:Key="AppFontFamily">Segoe UI</media:FontFamily>
        <x:Double x:Key="AppFontSize.Caption">11</x:Double>
        <x:Double x:Key="AppFontSize.Body">12</x:Double>
        <x:Double x:Key="AppFontSize.Primary">13</x:Double>
        <x:Double x:Key="AppFontSize.Emphasis">15</x:Double>
        <x:Double x:Key="AppFontSize.Title">18</x:Double>

        <Color x:Key="AppColor.Canvas">#080C10</Color>
        <SolidColorBrush x:Key="AppBrush.Canvas" Color="{StaticResource AppColor.Canvas}" />
        <SolidColorBrush x:Key="AppBrush.Band">#0C1217</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.Surface">#111920</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.SurfaceRaised">#151F27</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.SurfaceHover">#1A2730</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.SurfaceSelected">#222B2E</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.Separator">#2B3944</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.SeparatorStrong">#526676</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.Text">#F1F6FB</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.TextMuted">#B0C1D0</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.TextSubtle">#8595A2</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.Accent">#E3C78C</SolidColorBrush>
        <SolidColorBrush x:Key="AppBrush.AccentStrong">#F0DCA8</SolidColorBrush>

        <StaticResource x:Key="ThemeAccentBrush" ResourceKey="AppBrush.Accent" />
        <StaticResource x:Key="HighlightBrush" ResourceKey="AppBrush.Accent" />
        <StaticResource x:Key="ThemeForegroundBrush" ResourceKey="AppBrush.Text" />
        <StaticResource x:Key="ThemeBackgroundBrush" ResourceKey="AppBrush.Band" />
        <StaticResource x:Key="ThemeControlMidBrush" ResourceKey="AppBrush.SurfaceRaised" />
        <StaticResource x:Key="ThemeControlHighBrush" ResourceKey="AppBrush.SurfaceSelected" />
        <StaticResource x:Key="ThemeBorderLowBrush" ResourceKey="AppBrush.Separator" />
        <StaticResource x:Key="ThemeBorderMidBrush" ResourceKey="AppBrush.SeparatorStrong" />
        <StaticResource x:Key="ThemeBorderHighBrush" ResourceKey="AppBrush.TextSubtle" />

        <Template x:Key="AppFocusAdorner">
            <Border BorderBrush="{StaticResource AppBrush.Accent}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False" />
        </Template>

        <ControlTheme x:Key="AppButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrush.Separator}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{StaticResource AppFocusAdorner}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      RecognizesAccessKey="True" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBrush.SeparatorStrong}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceSelected}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="CommonScrollbarPageButtonTheme"
                      TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="CommonScrollbarThumbTheme"
                      TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource AppBrush.SeparatorStrong}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="999" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{StaticResource AppBrush.TextSubtle}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{StaticResource AppBrush.TextMuted}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="CommonScrollbarTheme"
                      TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource AppBrush.SurfaceRaised}" />
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0" />
            </Style>

            <Style Selector="^:horizontal">
                <Setter Property="Height" Value="14" />
                <Setter Property="Margin" Value="4,4,4,3" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid Height="{TemplateBinding Height}">
                            <Border Height="4"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="999"
                                    VerticalAlignment="Center" />
                            <Track Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_PageUpButton"
                                                  Theme="{StaticResource CommonScrollbarPageButtonTheme}"
                                                  Focusable="False" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_PageDownButton"
                                                  Theme="{StaticResource CommonScrollbarPageButtonTheme}"
                                                  Focusable="False" />
                                </Track.IncreaseButton>
                                <Thumb Theme="{StaticResource CommonScrollbarThumbTheme}"
                                       MinWidth="28"
                                       Padding="0,3" />
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Style>

            <Style Selector="^:vertical">
                <Setter Property="Width" Value="14" />
                <Setter Property="Margin" Value="4,4,3,4" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid Width="{TemplateBinding Width}">
                            <Border Width="4"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="999"
                                    HorizontalAlignment="Center" />
                            <Track Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_PageUpButton"
                                                  Theme="{StaticResource CommonScrollbarPageButtonTheme}"
                                                  Focusable="False" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_PageDownButton"
                                                  Theme="{StaticResource CommonScrollbarPageButtonTheme}"
                                                  Focusable="False" />
                                </Track.IncreaseButton>
                                <Thumb Theme="{StaticResource CommonScrollbarThumbTheme}"
                                       MinHeight="28"
                                       Padding="3,0" />
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector=":is(TemplatedControl)">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
    </Style>

    <Style Selector="controls|NumericBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AppFontSize.Body}" />
    </Style>

    <Style Selector="Window.AppWindow">
        <Setter Property="Background" Value="{StaticResource AppBrush.Canvas}" />
        <Setter Property="Foreground" Value="{StaticResource AppBrush.Text}" />
    </Style>

    <Style Selector="Button.AppButton, Button.AppIconButton">
        <Setter Property="Theme" Value="{StaticResource AppButtonTheme}" />
    </Style>

    <Style Selector="Button.AppButton">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style Selector="Button.AppIconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Path.Glyph">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{StaticResource AppBrush.Text}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.GlyphSm">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="Path.GlyphMd">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Path.GlyphLg">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="ScrollViewer.AppScrollViewer /template/ ScrollBar">
        <Setter Property="Theme" Value="{StaticResource CommonScrollbarTheme}" />
    </Style>

    <Style Selector="ListBox.AppScrollViewer /template/ ScrollViewer /template/ ScrollBar">
        <Setter Property="Theme" Value="{StaticResource CommonScrollbarTheme}" />
    </Style>

    <Style Selector="controls|AnimatedItemsView.AppScrollViewer > ScrollBar">
        <Setter Property="Theme" Value="{StaticResource CommonScrollbarTheme}" />
    </Style>

    <Style Selector="Popup">
        <Setter Property="InheritsTransform" Value="True" />
    </Style>
</Styles>
