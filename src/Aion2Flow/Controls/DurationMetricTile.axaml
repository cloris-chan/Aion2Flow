<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
             x:Class="Cloris.Aion2Flow.Controls.DurationMetricTile"
             x:DataType="controls:DurationMetricTile"
             x:Name="Root">
    <Border Classes="MetricCardSurface">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="0">
            <Border Classes="MetricAccent" />
            <StackPanel Grid.Column="1"
                        Classes="MetricContent"
                        Spacing="4">
                <TextBlock Classes="MetricLabel"
                           Text="{Binding Label, ElementName=Root}" />
                <controls:DurationBlock Classes="MetricValue"
                                        Duration="{Binding Duration, ElementName=Root}"
                                        DisplayFormat="{Binding DisplayFormat, ElementName=Root}"
                                        StableWidthScopeKey="{Binding StableWidthScopeKey, ElementName=Root}"
                                        HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
