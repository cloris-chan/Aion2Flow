<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
             xmlns:markups="clr-namespace:Cloris.Aion2Flow.Markups"
             xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
             x:Class="Cloris.Aion2Flow.Views.SkillMonitorSettingsView"
             x:DataType="vm:SkillMonitorSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="Expander.MonitorClassGroup">
            <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Separator}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="TextBlock.MonitorSkillName">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="controls|SkillIcon.MonitorSkillOptionIcon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Stretch" Value="UniformToFill" />
        </Style>
    </UserControl.Styles>

    <Border Classes="SettingsGroup">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <StackPanel>
                    <TextBlock Classes="SettingsLabel" Text="{markups:Translate Settings_SkillMonitor_BuffDisplay}" />
                    <TextBlock Classes="SettingsHint" Text="{Binding BuffSelectionSummary}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="AppButton"
                        VerticalAlignment="Center"
                        Command="{Binding SelectAllBuffsCommand}"
                        Content="{markups:Translate Settings_SkillMonitor_SelectAll}" />
                <Button Grid.Column="2" Classes="AppButton"
                        VerticalAlignment="Center"
                        Command="{Binding ClearAllBuffsCommand}"
                        Content="{markups:Translate Settings_SkillMonitor_ClearAll}" />
            </Grid>
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="6">
                <StackPanel>
                    <TextBlock Classes="SettingsLabel" Text="{markups:Translate Settings_SkillMonitor_CooldownDisplay}" />
                    <TextBlock Classes="SettingsHint" Text="{Binding CooldownSelectionSummary}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="AppButton"
                        VerticalAlignment="Center"
                        Command="{Binding SelectAllCooldownsCommand}"
                        Content="{markups:Translate Settings_SkillMonitor_SelectAll}" />
                <Button Grid.Column="2" Classes="AppButton"
                        VerticalAlignment="Center"
                        Command="{Binding ClearAllCooldownsCommand}"
                        Content="{markups:Translate Settings_SkillMonitor_ClearAll}" />
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,156,44" ColumnSpacing="10">
                <TextBlock x:Name="MonitorScaleLabel" Classes="SettingsLabel"
                           Text="{markups:Translate Settings_SkillMonitor_Scale}" />
                <Slider x:Name="SkillMonitorScaleSlider"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.LabeledBy="{Binding #MonitorScaleLabel}"
                        Minimum="50"
                        Maximum="200"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding SkillMonitorScalePercent, Mode=OneWay}"
                        Loaded="SkillMonitorScaleSliderLoaded"
                        KeyUp="SkillMonitorScaleSliderKeyUp" />
                <TextBlock Grid.Column="2"
                           Classes="SettingsValue"
                           TextAlignment="Right"
                           Text="{Binding #SkillMonitorScaleSlider.Value, StringFormat='{}{0:F0}%'}" />
            </Grid>
            <Border Grid.Row="3"
                    HorizontalAlignment="Left"
                    Width="{Binding #SkillOptionsScroller.Viewport.Width}"
                    Padding="7,0">
                <Grid ColumnDefinitions="38,*,64,64" ColumnSpacing="8">
                    <TextBlock Grid.Column="2"
                               Classes="SettingsHint"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{markups:Translate Settings_SkillMonitor_BuffColumn}" />
                    <TextBlock Grid.Column="3"
                               Classes="SettingsHint"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{markups:Translate Settings_SkillMonitor_CooldownColumn}" />
                </Grid>
            </Border>
            <ScrollViewer x:Name="SkillOptionsScroller" Grid.Row="4" Classes="AppScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkillMonitorClassGroup">
                            <Expander Classes="MonitorClassGroup"
                                      Header="{Binding HeaderText}"
                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <ItemsControl ItemsSource="{Binding Skills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SkillMonitorSkillOption">
                                            <Grid Margin="0,2"
                                                  ColumnDefinitions="Auto,*,64,64"
                                                  ColumnSpacing="8">
                                                <controls:SkillIcon Classes="MonitorSkillOptionIcon"
                                                                    AssetName="{Binding IconAssetName}" />
                                                <TextBlock Grid.Column="1"
                                                           Classes="MonitorSkillName"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <CheckBox Grid.Column="2"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="{markups:Translate Settings_SkillMonitor_BuffDisplay}"
                                                          IsChecked="{Binding IsBuffSelected, Mode=TwoWay}" />
                                                <CheckBox Grid.Column="3"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="{markups:Translate Settings_SkillMonitor_CooldownDisplay}"
                                                          IsChecked="{Binding IsCooldownSelected, Mode=TwoWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
