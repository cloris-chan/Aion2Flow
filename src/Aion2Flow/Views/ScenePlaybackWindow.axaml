<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
        xmlns:conv="clr-namespace:Cloris.Aion2Flow.Converters"
        xmlns:markups="clr-namespace:Cloris.Aion2Flow.Markups"
        xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
        xmlns:pres="clr-namespace:Cloris.Aion2Flow.Presentation"
        xmlns:views="clr-namespace:Cloris.Aion2Flow.Views"
        x:Class="Cloris.Aion2Flow.Views.ScenePlaybackWindow"
        x:DataType="vm:ScenePlaybackViewModel"
        Classes="PlaybackWindow"
        Width="1600"
        Height="900"
        MinWidth="1320"
        MinHeight="700"
        Title="{Binding WindowTitle}"
        Icon="/Assets/Images/Aion2Flow.png">
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <DataTemplate x:Key="PlaybackAuraTimelineLaneTemplate" x:DataType="pres:PlaybackAuraTimelineLane">
            <Border Classes="PlaybackDetailTimelineRow">
                <Grid Classes="PlaybackDetailTimelineGrid"
                      RowDefinitions="30,8"
                      ColumnDefinitions="230,120,120,80,*"
                      ColumnSpacing="8">
                    <controls:SkillDisplay Classes="PlaybackAuraSkill"
                                           SkillCode="{Binding SkillCode}"
                                           FallbackText="{Binding FallbackText}"
                                           IconSize="18" />
                    <StackPanel Grid.Column="1" Classes="PlaybackInlineMetric">
                        <TextBlock Classes="PlaybackDetailSubtle" Text="{markups:Translate Playback_Metric_Coverage}" />
                        <TextBlock Classes="PlaybackDetailSubtleValue" Text="{Binding CoverageText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="PlaybackInlineMetric">
                        <TextBlock Classes="PlaybackDetailSubtle" Text="{markups:Translate Playback_Metric_ActiveTime}" />
                        <TextBlock Classes="PlaybackDetailSubtleValue" Text="{Binding ActiveTimeText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Classes="PlaybackInlineMetric">
                        <TextBlock Classes="PlaybackDetailSubtle" Text="{markups:Translate Playback_Metric_Count}" />
                        <TextBlock Classes="PlaybackDetailSubtleValue" Text="{Binding Count}" />
                    </StackPanel>
                    <Grid Grid.Column="4"
                          ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="4"
                          VerticalAlignment="Center">
                        <TextBlock Classes="PlaybackDetailSubtle" Text="{markups:Translate Playback_AuraDisposition_Label}" />
                        <TextBlock Grid.Column="1"
                                   Classes="PlaybackDetailSubtleValue"
                                   Text="{Binding DispositionText}" />
                        <TextBlock Grid.Column="2"
                                   Classes="PlaybackDetailSubtle"
                                   Text="{Binding SemanticTraceText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding SemanticTraceText}" />
                    </Grid>
                    <controls:PlaybackTimelineView Grid.Row="1"
                                                   Grid.ColumnSpan="5"
                                                   Classes="PlaybackTimelineRail PlaybackAuraTimelineLane PlaybackTimelineBackgroundRail"
                                                   Markers="{Binding Markers}"
                                                   Spans="{Binding Spans}"
                                                   Viewport="{Binding $parent[Window].DataContext.TimelineViewport}"
                                                   PositionMilliseconds="{Binding $parent[Window].DataContext.PositionMilliseconds}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://Aion2Flow/Styles/PlaybackTheme.axaml" />
    </Window.Styles>

    <Grid x:Name="RootLayout"
          RowDefinitions="Auto,Auto,*"
          MinWidth="0"
          controls:DisplayContextProvider.DisplayContext="{Binding DisplayContext}">
        <Border Grid.Row="0" Classes="PlaybackCommandBar">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="PlaybackSceneTitle" Text="{Binding SceneName}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="PlaybackHeaderSubtle" Text="{Binding SceneStartedText}" />
                        <TextBlock Classes="PlaybackHeaderStatus" Text="{Binding StatusText}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <Button Classes="PlaybackIconButton PlaybackPrimaryButton"
                            Command="{Binding TogglePlayPauseCommand}"
                            IsVisible="{Binding IsPlaying, Converter={StaticResource InverseBooleanConverter}}">
                        <Path Classes="PlaybackGlyph" Data="{StaticResource play}" />
                    </Button>
                    <Button Classes="PlaybackIconButton PlaybackPrimaryButton"
                            Command="{Binding TogglePlayPauseCommand}"
                            IsVisible="{Binding IsPlaying}">
                        <Path Classes="PlaybackGlyph" Data="{StaticResource pause}" />
                    </Button>
                    <Button Classes="PlaybackIconButton" Command="{Binding StopCommand}">
                        <Path Classes="PlaybackGlyph" Data="{StaticResource square}" />
                    </Button>
                    <Border Classes="PlaybackToolbarDivider" />
                    <Button Classes="PlaybackIconButton"
                            Command="{Binding StepEventBackwardCommand}"
                            ToolTip.Tip="{markups:Translate Playback_PreviousEvent}">
                        <Path Classes="PlaybackGlyph" Data="{StaticResource chevron-left}" />
                    </Button>
                    <Button Classes="PlaybackIconButton"
                            Command="{Binding StepBackwardCommand}"
                            ToolTip.Tip="{markups:Translate Playback_PreviousSecond}">
                        <Path Classes="PlaybackGlyph" Data="{StaticResource skip-back}" />
                    </Button>
                    <Button Classes="PlaybackIconButton"
                            Command="{Binding StepForwardCommand}"
                            ToolTip.Tip="{markups:Translate Playback_NextSecond}">
                        <Path Classes="PlaybackGlyph" Data="{StaticResource skip-forward}" />
                    </Button>
                    <Button Classes="PlaybackIconButton"
                            Command="{Binding StepEventForwardCommand}"
                            ToolTip.Tip="{markups:Translate Playback_NextEvent}">
                        <Path Classes="PlaybackGlyph" Data="{StaticResource chevron-right}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <TextBlock Classes="PlaybackMetricLabel"
                               Text="{markups:Translate Playback_Label_Speed}" />
                    <Button Classes="PlaybackSpeedButton"
                            Classes.PlaybackSelected="{Binding IsHalfSpeed}"
                            Content="0.5x"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="0.5" />
                    <Button Classes="PlaybackSpeedButton"
                            Classes.PlaybackSelected="{Binding IsNormalSpeed}"
                            Content="1x"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="1" />
                    <Button Classes="PlaybackSpeedButton"
                            Classes.PlaybackSelected="{Binding IsDoubleSpeed}"
                            Content="2x"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="2" />
                    <Button Classes="PlaybackSpeedButton"
                            Classes.PlaybackSelected="{Binding IsQuadrupleSpeed}"
                            Content="4x"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="4" />
                    <Border Classes="PlaybackToolbarDivider" />
                    <TextBlock Classes="PlaybackMetricLabel"
                               Text="{markups:Translate Playback_Label_Zoom}" />
                    <Button Classes="PlaybackIconButton"
                            Command="{Binding ZoomTimelineOutCommand}"
                            ToolTip.Tip="{markups:Translate Playback_ZoomOut}">
                        <Path Classes="PlaybackGlyph" Data="{StaticResource minus}" />
                    </Button>
                    <Button Classes="PlaybackSpeedButton"
                            Content="{Binding TimelineZoomText}"
                            Command="{Binding ResetTimelineZoomCommand}"
                            ToolTip.Tip="{markups:Translate Playback_ZoomReset}" />
                    <Button Classes="PlaybackIconButton"
                            Command="{Binding ZoomTimelineInCommand}"
                            ToolTip.Tip="{markups:Translate Playback_ZoomIn}">
                        <Path Classes="PlaybackGlyph" Data="{StaticResource plus}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="PlaybackOverviewBand">
            <Grid RowDefinitions="Auto,30,28" RowSpacing="4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="PlaybackMetricValue" Text="{Binding PositionText}" />
                        <TextBlock Classes="PlaybackHeaderSubtle" Text="/" />
                        <TextBlock Classes="PlaybackHeaderSubtle" Text="{Binding DurationText}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Border Classes="PlaybackTrackAccent" Background="{StaticResource PlaybackBrush.TimelineCombat}" />
                            <TextBlock Classes="PlaybackTrackName" Text="{markups:Translate Playback_Track_Combat}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Border Classes="PlaybackTrackAccent" Background="{StaticResource PlaybackBrush.TimelineMechanic}" />
                            <TextBlock Classes="PlaybackTrackName" Text="{markups:Translate Playback_Track_Mechanic}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Border Classes="PlaybackTrackAccent" Background="{StaticResource PlaybackBrush.TimelineResource}" />
                            <TextBlock Classes="PlaybackTrackName" Text="{markups:Translate Playback_Track_Resource}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Border Classes="PlaybackTrackAccent" Background="{StaticResource PlaybackBrush.TimelineEntityVital}" />
                            <TextBlock Classes="PlaybackTrackName" Text="{markups:Translate Playback_Track_RemainingHp}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Border Classes="PlaybackTrackAccent" Background="{StaticResource PlaybackBrush.TimelineAura}" />
                            <TextBlock Classes="PlaybackTrackName" Text="{markups:Translate Playback_Track_Aura}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Border Classes="PlaybackTrackAccent" Background="{StaticResource PlaybackBrush.TimelineState}" />
                            <TextBlock Classes="PlaybackTrackName" Text="{markups:Translate Playback_Track_State}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Border Classes="PlaybackTrackAccent" Background="{StaticResource PlaybackBrush.TimelineScene}" />
                            <TextBlock Classes="PlaybackTrackName" Text="{markups:Translate Playback_Track_Scene}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Border Classes="PlaybackTrackAccent" Background="{StaticResource PlaybackBrush.TimelineAction}" />
                            <TextBlock Classes="PlaybackTrackName" Text="{markups:Translate Playback_Track_Action}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Border Classes="PlaybackTrackAccent" Background="{StaticResource PlaybackBrush.TimelineDiagnostic}" />
                            <TextBlock Classes="PlaybackTrackName" Text="{markups:Translate Playback_Track_Diagnostic}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Border Classes="PlaybackTrackAccent" Background="{StaticResource PlaybackBrush.TimelineOther}" />
                            <TextBlock Classes="PlaybackTrackName" Text="{markups:Translate Playback_Track_Other}" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
                <controls:PlaybackTimelineRulerView Grid.Row="1"
                                                    Classes="PlaybackTimelineRuler"
                                                    Viewport="{Binding TimelineViewport}"
                                                    PositionMilliseconds="{Binding PositionMilliseconds}"
                                                    SeekRequested="TimelineSeekRequested"
                                                    PointerWheelChanged="TimelinePointerWheelChanged" />
                <controls:PlaybackTimelineStripView Grid.Row="2"
                                                    Classes="PlaybackTimelineStrip PlaybackGlobalTimelineStrip"
                                                    Bands="{Binding GlobalTimeline.Bands}"
                                                    Viewport="{Binding TimelineViewport}"
                                                    PositionMilliseconds="{Binding PositionMilliseconds}"
                                                    SeekRequested="TimelineSeekRequested"
                                                    PointerWheelChanged="TimelinePointerWheelChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="330,4,*" MinHeight="0">
            <Border Grid.Column="0" Classes="PlaybackRosterPane">
                <Grid RowDefinitions="Auto,Auto,*" MinHeight="0">
                    <Border Background="{StaticResource AppBrush.Band}"
                            BorderBrush="{StaticResource AppBrush.Separator}"
                            BorderThickness="0,0,0,1"
                            Padding="12,9">
                        <TextBlock Classes="PlaybackPanelTitle"
                                   Text="{markups:Translate Playback_Combatants}" />
                    </Border>
                    <Grid Grid.Row="1"
                          Classes="PlaybackTableHeader"
                          ColumnDefinitions="*,68,88"
                          ColumnSpacing="8"
                           Margin="12,0,32,0">
                        <TextBlock Classes="PlaybackHeaderCell"
                                   Text="{markups:Translate Playback_Column_Combatant}" />
                        <TextBlock Grid.Column="1"
                                   Classes="PlaybackHeaderCellRight"
                                   Text="{markups:Translate Metric_Dps}" />
                        <TextBlock Grid.Column="2"
                                   Classes="PlaybackHeaderCellRight"
                                   Text="{markups:Translate Playback_Column_Damage}" />
                    </Grid>
                    <ScrollViewer Grid.Row="2"
                                  Classes="AppScrollViewer"
                                  HorizontalContentAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <controls:AnimatedItemsView Classes="PlaybackCombatantList AppScrollViewer"
                                                    ItemsSource="{Binding Combatants}"
                                                    SelectedItem="{Binding SelectedCombatant, Mode=TwoWay}"
                                                    ItemHeight="54"
                                                    MaxVisibleItems="64"
                                                    VerticalScrollBarVisibility="Visible">
                            <controls:AnimatedItemsView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaybackCombatantRowViewModel">
                                    <Border Classes="PlaybackCombatantRow"
                                            Classes.selected="{Binding $parent[controls:AnimatedItemsViewItem].IsSelected}">
                                        <Grid RowDefinitions="Auto,8"
                                              ColumnDefinitions="*,68,88"
                                              ColumnSpacing="8"
                                              Margin="12,6">
                                    <controls:CombatantDisplay Classes="PlaybackCombatantName"
                                                               EntityId="{Binding EntityId}"
                                                               IconSize="22" />
                                    <TextBlock Grid.Column="1"
                                               Classes="PlaybackRowValue PlaybackNumericCell"
                                               Text="{Binding DamagePerSecondText}" />
                                    <TextBlock Grid.Column="2"
                                               Classes="PlaybackRowSubtle PlaybackNumericCell"
                                               Text="{Binding DamageText}" />
                                    <controls:PlaybackTimelineStripView Grid.Row="1"
                                                                        Grid.ColumnSpan="3"
                                                                        Classes="PlaybackTimelineStrip PlaybackTimelineBackgroundStrip"
                                                                        Bands="{Binding Timeline.Bands}"
                                                                        Viewport="{Binding $parent[Window].DataContext.TimelineViewport}"
                                                                        PositionMilliseconds="{Binding $parent[Window].DataContext.PositionMilliseconds}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </controls:AnimatedItemsView.ItemTemplate>
                        </controls:AnimatedItemsView>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Background="{StaticResource AppBrush.Separator}"
                          ResizeDirection="Columns"
                          HorizontalAlignment="Stretch" />

            <Border Grid.Column="2" Classes="PlaybackWorkspacePane">
                <Grid RowDefinitions="Auto,Auto,*,4,260" MinHeight="0">
                    <Border Classes="PlaybackSelectionSummary"
                            IsVisible="{Binding HasSelectedCombatant}">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="24">
                            <controls:CombatantDisplay Classes="PlaybackCombatantName"
                                                       EntityId="{Binding SelectedCombatantId}"
                                                       IconSize="28" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Classes="PlaybackMetricLabel"
                                           Text="{markups:Translate Playback_Column_Damage}" />
                                <TextBlock Classes="PlaybackMetricValue"
                                           Text="{Binding SelectedCombatantDamageText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Classes="PlaybackMetricLabel"
                                           Text="{markups:Translate Metric_Dps}" />
                                <TextBlock Classes="PlaybackMetricValue"
                                           Text="{Binding SelectedCombatantDpsText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Classes="PlaybackMetricLabel"
                                           Text="{markups:Translate Playback_Column_Healing}" />
                                <TextBlock Classes="PlaybackMetricValue"
                                           Text="{Binding SelectedCombatantHealingText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Classes="PlaybackMetricLabel"
                                           Text="{markups:Translate Playback_Column_RemainingHp}" />
                                <TextBlock Classes="PlaybackMetricValue"
                                           Text="{Binding SelectedCombatantHpText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Classes="PlaybackWorkspaceTabStrip"
                            IsVisible="{Binding HasSelectedCombatant}">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Classes="PlaybackWorkspaceTab"
                                    Classes.PlaybackSelected="{Binding IsOutgoingDetailSelected}"
                                    Content="{markups:Translate Direction_Outgoing}"
                                    Command="{Binding ShowOutgoingDetailCommand}" />
                            <Button Classes="PlaybackWorkspaceTab"
                                    Classes.PlaybackSelected="{Binding IsIncomingDetailSelected}"
                                    Content="{markups:Translate Direction_Incoming}"
                                    Command="{Binding ShowIncomingDetailCommand}" />
                            <Button Classes="PlaybackWorkspaceTab"
                                    Classes.PlaybackSelected="{Binding IsAurasDetailSelected}"
                                    Content="{markups:Translate Playback_AuraCoverage}"
                                    Command="{Binding ShowAurasDetailCommand}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" MinHeight="0">
                        <TextBlock Classes="PlaybackEmptyState"
                                   IsVisible="{Binding HasSelectedCombatant, Converter={StaticResource InverseBooleanConverter}}"
                                   Text="{markups:Translate Playback_SelectCombatant}" />

                        <ScrollViewer Classes="PlaybackDetailScroller AppScrollViewer"
                                      IsVisible="{Binding IsOutgoingDetailVisible}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <views:CombatDirectionDetailView DataContext="{Binding CombatantDetails.OutgoingDetail}"
                                                             SelectionRequested="CombatDetailSelectionRequested" />
                        </ScrollViewer>

                        <ScrollViewer Classes="PlaybackDetailScroller AppScrollViewer"
                                      IsVisible="{Binding IsIncomingDetailVisible}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <views:CombatDirectionDetailView DataContext="{Binding CombatantDetails.IncomingDetail}"
                                                             SelectionRequested="CombatDetailSelectionRequested" />
                        </ScrollViewer>

                        <ListBox Classes="PlaybackWorkspaceList PlaybackAuraList AppScrollViewer"
                                 IsVisible="{Binding IsAurasDetailVisible}"
                                 ItemsSource="{Binding AuraTimelineTracks}"
                                 SelectedItem="{Binding SelectedAura, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource PlaybackAuraTimelineLaneTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel CacheLength="0.5" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock Classes="PlaybackEmptyState"
                                   IsVisible="{Binding IsAurasDetailEmpty}"
                                   Text="{markups:Translate Playback_NoData}" />
                    </Grid>

                    <GridSplitter Grid.Row="3"
                                  Classes="PlaybackHorizontalSplitter"
                                  ResizeDirection="Rows"
                                  VerticalAlignment="Stretch" />

                    <views:PlaybackEventWindowView Grid.Row="4" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
