<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
        xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
        x:Class="Cloris.Aion2Flow.Views.SkillMonitorWindow"
        x:DataType="vm:SkillMonitorViewModel"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SizeToContent="Height"
        Width="680"
        MinWidth="100"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="False">

    <Window.Styles>
        <StyleInclude Source="avares://Aion2Flow/Styles/OverlayTheme.axaml" />

        <Style Selector="controls|PerimeterProgressBar.MonitorBuffPerimeter">
            <Setter Property="Fill" Value="{StaticResource OverlayBrush.MainHudGold}" />
            <Setter Property="Thickness" Value="3" />
        </Style>

        <Style Selector="controls|SkillIcon.MonitorSkillIcon">
            <Setter Property="Stretch" Value="UniformToFill" />
        </Style>

        <Style Selector="TextBlock.MonitorCooldownText">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="ZIndex" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="2" OffsetX="0" OffsetY="0" Opacity="0.95" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="TextBlock.MonitorBuffText">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="ZIndex" Value="11" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="2" OffsetX="0" OffsetY="0" Opacity="0.95" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.MonitorChargeBadge">
            <Setter Property="Background" Value="#D9000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="ZIndex" Value="12" />
        </Style>

        <Style Selector="TextBlock.MonitorChargeText">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style Selector="Border.MonitorWindowRoot">
            <Setter Property="Background" Value="{StaticResource OverlayBrush.MainHudBackdrop}" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Border.MonitorWindowRoot.unfocused">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Border.MonitorWidthResizeGrip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.MainHudGold}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="ZIndex" Value="20" />
        </Style>

        <Style Selector="Border.MonitorWindowRoot.interactive Border.MonitorWidthResizeGrip">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="TextBlock.MonitorInteractionTitle">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,2,10,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Border.MonitorWindowRoot.interactive TextBlock.MonitorInteractionTitle">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </Window.Styles>

    <Border x:Name="MonitorRoot"
            Classes="MonitorWindowRoot"
            Padding="4,4,10,4"
            PointerPressed="DragWindow">
        <Grid RowDefinitions="Auto,Auto">
            <TextBlock x:Name="MonitorInteractionTitle"
                       Grid.Row="0"
                       Classes="MonitorInteractionTitle" />

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding SkillRows}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkillMonitorSkillSlot">
                        <Grid Width="76"
                              Height="82"
                              Margin="0,0,6,6"
                              ToolTip.Tip="{Binding ToolTipText}">
                            <Grid Width="60"
                                  Height="60"
                                  Margin="8">
                                <Image Source="/Assets/Images/Hud/Cooldown/QuickSlotSkill_EmptyFrame.png"
                                       Stretch="Fill"
                                       IsHitTestVisible="False" />
                                <Border Margin="3"
                                        CornerRadius="2"
                                        ClipToBounds="True">
                                    <controls:SkillIcon Classes="MonitorSkillIcon"
                                                        AssetName="{Binding IconAssetName}" />
                                </Border>
                                <controls:CooldownSkillVisual CooldownProgress="{Binding CooldownProgressValue}"
                                                              CompletionStartedUtcMilliseconds="{Binding CompletionStartedUtcMilliseconds}"
                                                              IsHitTestVisible="False" />
                                <TextBlock Classes="MonitorBuffText"
                                           Margin="4,3,4,0"
                                           Text="{Binding BuffRemainingText}"
                                           IsVisible="{Binding HasBuff}"
                                           IsHitTestVisible="False" />
                                <Grid ColumnDefinitions="Auto,*"
                                      VerticalAlignment="Bottom"
                                      ZIndex="12"
                                      IsHitTestVisible="False">
                                    <Border Classes="MonitorChargeBadge"
                                            Margin="0"
                                            IsVisible="{Binding HasAvailableCount}">
                                        <TextBlock Classes="MonitorChargeText"
                                                   Text="{Binding AvailableCountText}" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Classes="MonitorCooldownText"
                                               Margin="3,0,3,3"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Right"
                                               Text="{Binding CooldownRemainingText}"
                                               IsVisible="{Binding HasCooldown}" />
                                </Grid>
                                <controls:PerimeterProgressBar Classes="MonitorBuffPerimeter"
                                                               Value="{Binding BuffProgressValue}"
                                                               IsVisible="{Binding HasBuff}"
                                                               IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="MonitorWidthResizeGrip"
                    Grid.RowSpan="2"
                    PointerPressed="ResizeWindow"
                    IsHitTestVisible="True" />
        </Grid>
    </Border>
</Window>
