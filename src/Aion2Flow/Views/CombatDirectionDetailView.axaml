<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Cloris.Aion2Flow.Views"
             xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
             x:Class="Cloris.Aion2Flow.Views.CombatDirectionDetailView"
             x:DataType="vm:CombatDirectionDetailViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares://Aion2Flow/Styles/OverlayTheme.axaml" />
    </UserControl.Styles>

    <StackPanel Orientation="Vertical"
                Spacing="14">
        <views:DamageDetailView x:Name="DamageDetail"
                                DataContext="{Binding}"
                                SelectionRequested="ChildSelectionRequested" />
        <views:HealingDetailView x:Name="HealingDetail"
                                 DataContext="{Binding}"
                                 SelectionRequested="ChildSelectionRequested" />
        <views:ShieldDetailView x:Name="ShieldDetail"
                                DataContext="{Binding}"
                                SelectionRequested="ChildSelectionRequested" />
        <views:ResourceDetailView x:Name="ResourceDetail"
                                  DataContext="{Binding}" />
    </StackPanel>
</UserControl>
