<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cloris.Aion2Flow.Views.OverlayPinWindow"
        Classes="OverlayPinWindow"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Width="26"
        Height="26"
        MinWidth="0"
        MinHeight="0"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowActivated="False"
        ShowInTaskbar="False">

    <Window.Styles>
        <StyleInclude Source="avares://Aion2Flow/Styles/OverlayTheme.axaml" />
    </Window.Styles>

    <Button x:Name="PinButton"
            Classes="BottomBarButton OverlayPinButton"
            Click="CycleInteractionMode">
        <Path Classes="Glyph GlyphMd"
              Data="{StaticResource pin}" />
    </Button>
</Window>
