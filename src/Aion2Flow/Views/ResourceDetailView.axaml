<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markups="clr-namespace:Cloris.Aion2Flow.Markups"
             xmlns:conv="clr-namespace:Cloris.Aion2Flow.Converters"
             xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
             xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
             x:Class="Cloris.Aion2Flow.Views.ResourceDetailView"
             x:DataType="vm:CombatDirectionDetailViewModel">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Aion2Flow/Styles/OverlayTheme.axaml" />
    </UserControl.Styles>

    <Border x:Name="ResourceSummaryCard"
            Classes="DetailSummaryCard">
        <StackPanel Orientation="Vertical"
                    Spacing="12">
            <Border Classes="DetailSummaryPanel">
                <StackPanel Orientation="Vertical"
                            Spacing="0">
                    <Border Classes="DetailSummaryBanner">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Classes="DetailBannerTitle"
                                       Text="{markups:Translate Category_Resource}" />

                            <Grid x:Name="ResourceBannerMetrics"
                                  Grid.Column="1"
                                  Classes="DetailBannerMetrics"
                                  ColumnDefinitions="*">
                                <controls:MetricTile Grid.Column="0"
                                                     Classes="DetailBannerMetric"
                                                     Label="{markups:Translate Metric_ManaChange}"
                                                     Value="{Binding ResourceSection.ManaChange}" />
                            </Grid>

                            <Button Grid.Column="2"
                                    Classes="CounterpartSelectorButton"
                                    IsVisible="{Binding ResourceCounterpartFilter.HasCounterparts}"
                                    ToolTip.Tip="{Binding ResourceCounterpartFilter.CounterpartTitle}">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8"
                                      DataContext="{Binding ResourceCounterpartFilter}"
                                      x:DataType="vm:DetailCounterpartFilterViewModel">
                                    <TextBlock Classes="CounterpartSelectorText"
                                               Text="{Binding CounterpartSummary}" />
                                    <Path Grid.Column="1"
                                          Classes="CounterpartSelectorGlyph"
                                          Data="M 2 4 L 6 8 L 10 4" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight"
                                            ShowMode="Transient">
                                        <Border Classes="CounterpartSelectorFlyout"
                                                DataContext="{Binding ResourceCounterpartFilter}"
                                                x:DataType="vm:DetailCounterpartFilterViewModel">
                                            <Grid RowDefinitions="Auto,*"
                                                  RowSpacing="8">
                                                <Grid ColumnDefinitions="Auto,Auto,96"
                                                      ColumnSpacing="8">
                                                    <CheckBox Grid.Column="0"
                                                              Grid.ColumnSpan="2"
                                                              Classes="CounterpartSelectAll"
                                                              Content="{Binding CounterpartTitle}"
                                                              ToolTip.Tip="{markups:Translate Action_SelectAll}"
                                                              IsChecked="{Binding AreAllCounterpartsSelected, Mode=TwoWay}"
                                                              IsThreeState="True"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Classes="CounterpartHeaderText"
                                                               Text="{markups:Translate Metric_ManaChange}" />
                                                </Grid>

                                                <ScrollViewer Grid.Row="1"
                                                              Classes="CounterpartItemsScroller"
                                                              MaxHeight="260">
                                                    <ItemsControl ItemsSource="{Binding Counterparts}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DetailCounterpartSelectionViewModel">
                                                                <Border Classes="CounterpartRow">
                                                                    <Grid ColumnDefinitions="Auto,Auto,96"
                                                                          ColumnSpacing="4">
                                                                        <controls:SegmentedTableSeparator Grid.Column="0"
                                                                                                          Grid.ColumnSpan="3"
                                                                                                          LineBrush="{StaticResource OverlayBrush.DetailSeparator}"
                                                                                                          Classes="DetailTableRowSeparator" />
                                                                        <CheckBox Grid.Column="0"
                                                                                  Classes="CounterpartRowCheckBox"
                                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                  VerticalAlignment="Center" />
                                                                        <controls:CombatantDisplay Grid.Column="1"
                                                                                                    Classes="CounterpartName"
                                                                                                    EntityId="{Binding CombatantId}"
                                                                                                    VerticalAlignment="Center" />
                                                                        <controls:NumericBlock Grid.Column="2"
                                                                                               Classes="CounterpartMetricValue"
                                                                                               Value="{Binding ManaChange}" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Classes="DetailMetricRowsPanel">
                        <Border Classes="DetailMetricRowBand DetailMetricRowBandLast">
                            <Grid Classes="DetailMetricRow"
                                  ColumnDefinitions="*,*,*,*">
                                <controls:MetricTile Grid.Column="0"
                                                     Classes="DetailLineMetric"
                                                     Label="{markups:Translate Metric_ResourceSkills}"
                                                     Value="{Binding ResourceSection.SkillCount}" />
                                <controls:MetricTile Grid.Column="1"
                                                     Classes="DetailLineMetric"
                                                     Label="{markups:Translate Metric_ResourceEvents}"
                                                     Value="{Binding ResourceSection.EventCount}" />
                                <controls:MetricTile Grid.Column="2"
                                                     Classes="DetailLineMetric"
                                                     Label="{markups:Translate Metric_DirectEvents}"
                                                     Value="{Binding ResourceSection.DirectEvents}" />
                                <controls:MetricTile Grid.Column="3"
                                                     Classes="DetailLineMetric"
                                                     Label="{markups:Translate Metric_PeriodicEvents}"
                                                     Value="{Binding ResourceSection.PeriodicEvents}" />
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="DetailTableCard">
                <ScrollViewer Classes="DetailTableScroller AppScrollViewer">
                    <StackPanel Orientation="Vertical"
                                Spacing="6">
                        <Border Classes="DetailTableHeaderBand">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <controls:SegmentedTableSeparator Grid.Column="0"
                                                                  Grid.ColumnSpan="5"
                                                                  LineBrush="{StaticResource OverlayBrush.DetailHudLineSoft}"
                                                                  Classes="DetailTableHeaderSeparator" />
                                <TextBlock Grid.Column="0" Classes="DetailTableHeaderLeft" Text="{markups:Translate Column_Skill}" />
                                <TextBlock Grid.Column="1" Classes="DetailTableHeader" Text="{markups:Translate Metric_ManaChange}" />
                                <TextBlock Grid.Column="2" Classes="DetailTableHeader" Text="{markups:Translate Metric_DirectEvents}" />
                                <TextBlock Grid.Column="3" Classes="DetailTableHeader" Text="{markups:Translate Metric_PeriodicEvents}" />
                                <TextBlock Grid.Column="4" Classes="DetailTableHeader" Text="{markups:Translate Column_Events}" />
                            </Grid>
                        </Border>

                        <controls:AnimatedItemsView ItemsSource="{Binding ResourceSection.Rows}"
                                                    Classes="AppScrollViewer"
                                                    ItemHeight="36"
                                                    MaxVisibleItems="10"
                                                    IsSelectionEnabled="False">
                            <controls:AnimatedItemsView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResourceDetailRowViewModel">
                                    <Border Classes="DetailTableRow">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <controls:SegmentedTableSeparator Grid.Column="0"
                                                                              Grid.ColumnSpan="5"
                                                                              LineBrush="{StaticResource OverlayBrush.DetailSeparator}"
                                                                              Classes="DetailTableRowSeparator" />
                                            <controls:SkillDisplay Grid.Column="0"
                                                                   Classes="DetailRowText"
                                                                   SkillCode="{Binding SkillCode}"
                                                                   FallbackText="{Binding DisplayName}"
                                                                   IconSize="22"
                                                                   VerticalAlignment="Center" />
                                            <controls:NumericBlock Grid.Column="1" Classes="DetailRowValue" Value="{Binding ManaChange}" />
                                            <controls:NumericBlock Grid.Column="2" Classes="DetailRowValue" Value="{Binding DirectEvents}" />
                                            <controls:NumericBlock Grid.Column="3" Classes="DetailRowValue" Value="{Binding PeriodicEvents}" />
                                            <controls:NumericBlock Grid.Column="4" Classes="DetailRowValue" Value="{Binding EventCount}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </controls:AnimatedItemsView.ItemTemplate>
                        </controls:AnimatedItemsView>
                        <TextBlock Classes="OverlayMutedText"
                                   Text="{markups:Translate Empty_ResourceEvents}"
                                   IsVisible="{Binding ResourceSection.HasResources, Converter={StaticResource InverseBooleanConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
